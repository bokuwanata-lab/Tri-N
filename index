      playSound('click');
      currentLevelId = levelId;
      currentQuestionIndex = 0;
      sessionAnswers = Array.from({ length: 5 }, () => ({
        answered: false,
        isCorrect: false,
        points: 0,
        savedWords: null,
        savedText: ""
      }));

      showView('view-game');
      renderQuestion();
    }

    function getSessionScore() {
      return sessionAnswers.reduce((acc, item) => acc + item.points, 0);
    }

    // Render Progress Dots
    function renderProgressDots() {
      const container = document.getElementById('game-progress-dots');
      container.innerHTML = '';
      sessionAnswers.forEach((ans, idx) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        let classes = "w-7 h-7 sm:w-8 sm:h-8 rounded-full font-extrabold text-xs flex items-center justify-center border-2 transition ";
        if (idx === currentQuestionIndex) {
          classes += "ring-3 ring-sky-300 scale-110 ";
        }
        if (!ans.answered) {
          classes += "bg-white border-sky-300 text-sky-800";
          dot.textContent = idx + 1;
        } else if (ans.isCorrect) {
          classes += "bg-emerald-500 border-emerald-700 text-white";
          dot.textContent = "✓";
        } else {
          classes += "bg-rose-500 border-rose-700 text-white";
          dot.textContent = "✗";
        }
        dot.className = classes;
        dot.addEventListener('click', () => {
          playSound('click');
          currentQuestionIndex = idx;
          renderQuestion();
        });
        container.appendChild(dot);
      });
    }

