<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Petualangan Kalimat Ceria - Game Edukasi Anak SD</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Fredoka', 'Inter', sans-serif;
      background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #34d399 100%);
      min-height: 100vh;
      overflow-x: hidden;
      user-select: none;
    }
    /* Responsive 16:9 Stage Container */
    .stage-16-9 {
      width: 100%;
      max-width: 1120px;
      aspect-ratio: 16 / 9;
      background: linear-gradient(180deg, #bae6fd 0%, #e0f2fe 65%, #bbf7d0 100%);
      border: 6px solid #ffffff;
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.25);
    }
    @media (max-width: 768px) {
      .stage-16-9 {
        aspect-ratio: auto;
        min-height: 92vh;
      }
    }
    .game-card {
      background: rgba(255, 255, 255, 0.94);
      border: 3px solid #38bdf8;
      box-shadow: 0 8px 0 #0284c7, 0 12px 20px rgba(0,0,0,0.08);
    }
    .btn-3d {
      transition: all 0.15s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
    }
    .img-btn-transparent {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.18));
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .img-btn-transparent:hover:not(:disabled) {
      transform: scale(1.06);
      filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.24));
    }
    .img-btn-transparent:active:not(:disabled) {
      transform: translateY(3px) scale(0.98);
    }
    .word-chip {
      cursor: grab;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .word-chip:hover {
      transform: translateY(-2px) scale(1.03);
    }
    .word-chip:active {
      cursor: grabbing;
    }
    .drop-zone-active {
      background-color: #e0f2fe !important;
      border-color: #0284c7 !important;
      transform: scale(1.01);
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .animate-float {
      animation: floatSlow 3s ease-in-out infinite;
    }
    @keyframes popIn {
      0% { transform: scale(0.85); opacity: 0; }
      80% { transform: scale(1.03); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
  </style>
</head>
<body class="p-2 sm:p-4 flex items-center justify-center">

  <!-- 16:9 Game Stage Wrapper -->
  <div class="stage-16-9 rounded-3xl p-3 sm:p-5 flex flex-col justify-between overflow-y-auto">

    <!-- Top Navigation & Score Bar -->
    <header class="w-full flex flex-wrap items-center justify-between gap-2 bg-white/90 backdrop-blur-md px-4 py-2 rounded-2xl border-2 border-sky-300 shadow-sm mb-2">
      <div class="flex items-center gap-3">
        <!-- Transparent Games Title Logo -->
        <img src="data:image/png;base64," alt="Games Banner" class="h-9 sm:h-11 w-auto object-contain bg-transparent img-btn-transparent" />
        <div>
          <h1 class="text-base sm:text-lg font-extrabold text-sky-900 leading-tight">Petualangan Kalimat SD</h1>
          <p class="text-[11px] text-sky-600 font-semibold">Belajar Bahasa Indonesia Bersama Si Pensil</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- Total Score Badge -->
        <div class="flex items-center gap-1.5 bg-amber-100 border-2 border-amber-400 px-2.5 py-1 rounded-xl">
          <span class="text-lg">🏆</span>
          <div class="text-left">
            <div class="text-[9px] font-bold uppercase tracking-wider text-amber-700">Total Skor</div>
            <div id="header-total-score" class="text-xs sm:text-sm font-extrabold text-amber-900">0 / 300</div>
          </div>
        </div>

        <!-- Total Stars Badge -->
        <div class="flex items-center gap-1.5 bg-yellow-100 border-2 border-yellow-400 px-2.5 py-1 rounded-xl">
          <span class="text-lg">⭐</span>
          <div class="text-left">
            <div class="text-[9px] font-bold uppercase tracking-wider text-yellow-700">Bintang</div>
            <div id="header-total-stars" class="text-xs sm:text-sm font-extrabold text-yellow-900">0 / 9</div>
          </div>
        </div>

        <!-- Sound & Voice Toggle -->
        <button id="btn-sound-toggle" type="button" class="px-2.5 py-1.5 rounded-xl bg-sky-100 hover:bg-sky-200 border-2 border-sky-300 text-sky-800 font-bold text-xs sm:text-sm transition flex items-center gap-1" title="Suara & Audio Wanita">
          🔊
        </button>

        <!-- Home Map Button -->
        <button id="btn-home-map" type="button" class="px-3 py-1.5 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white font-bold text-xs sm:text-sm border-b-4 border-indigo-700 btn-3d flex items-center gap-1">
          <span>🗺️</span> <span>Peta Level</span>
        </button>
      </div>
    </header>

    <!-- Main Interactive Stage Area -->
    <main class="w-full flex-1 flex flex-col justify-center min-h-0">

      <!-- VIEW 1: HOME / LEVEL SELECTION MAP -->
      <section id="view-map" class="game-card rounded-3xl p-4 sm:p-5 animate-pop flex flex-col justify-between h-full">
        <!-- Hero Banner -->
        <div class="flex flex-col sm:flex-row items-center gap-4 mb-3 bg-gradient-to-r from-sky-100/90 via-indigo-50 to-amber-100/80 px-4 py-3 rounded-2xl border-2 border-sky-200">
          <div class="relative flex-shrink-0">
            <img id="mascot-home-img" src="data:image/png;base64," alt="Maskot Pensil" class="w-20 h-20 sm:w-24 sm:h-24 object-contain bg-transparent animate-float img-btn-transparent" />
          </div>
          <div class="text-center sm:text-left flex-1">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
              <span class="inline-block bg-sky-500 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full">MISI BAHASA INDONESIA SD</span>
              <span class="inline-block bg-pink-100 text-pink-700 border border-pink-300 text-[10px] font-bold px-2.5 py-0.5 rounded-full">👩🏻‍🏫 Dilengkapi Suara Pemandu Wanita</span>
            </div>
            <h2 class="text-lg sm:text-2xl font-extrabold text-slate-800">Halo, Sahabat Cilik! Yuk Selesaikan 3 Level!</h2>
            <p class="text-slate-600 text-xs sm:text-sm">
              Selesaikan <strong>Level 1</strong> untuk membuka <strong>Level 2</strong>, dan selesaikan <strong>Level 2</strong> untuk membuka <strong>Level 3</strong>!
            </p>
          </div>
        </div>

        <!-- 3 Level Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 my-auto">
          <!-- Level 1 Card -->
          <div id="card-level-1" class="rounded-2xl p-4 border-3 border-emerald-400 bg-emerald-50/90 flex flex-col justify-between transition relative overflow-hidden shadow">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="bg-emerald-500 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full">LEVEL 1</span>
                <div id="stars-level-1" class="text-base tracking-widest">☆☆☆</div>
              </div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-2xl">🧩</span>
                <h3 class="text-base sm:text-lg font-extrabold text-emerald-950">Susun Kalimat</h3>
              </div>
              <p class="text-xs text-emerald-800 mb-3">
                Tarik (drag) atau ketuk kata-kata acak hingga menjadi kalimat yang utuh dan benar! (5 Soal)
              </p>
            </div>
            <div>
              <div class="text-[11px] font-bold text-emerald-700 mb-1.5" id="score-label-1">Skor Terbaik: 0 / 100</div>
              <button id="btn-play-1" type="button" class="w-full py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm border-b-4 border-emerald-700 btn-3d shadow">
                ▶ Mulai Level 1
              </button>
            </div>
          </div>

          <!-- Level 2 Card -->
          <div id="card-level-2" class="rounded-2xl p-4 border-3 border-slate-300 bg-slate-100 flex flex-col justify-between transition relative overflow-hidden shadow">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span id="badge-level-2" class="bg-slate-500 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full">LEVEL 2 🔒</span>
                <div id="stars-level-2" class="text-base tracking-widest">☆☆☆</div>
              </div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-2xl">⌨️</span>
                <h3 class="text-base sm:text-lg font-extrabold text-slate-800">Lengkapi Kata</h3>
              </div>
              <p class="text-xs text-slate-600 mb-3">
                Ketik sendiri kata yang tepat untuk melengkapi bagian kalimat yang kosong! (5 Soal)
              </p>
            </div>
            <div>
              <div class="text-[11px] font-bold text-slate-600 mb-1.5" id="score-label-2">Terkunci (Selesaikan Level 1)</div>
              <button id="btn-play-2" type="button" disabled class="w-full py-2 rounded-xl bg-slate-300 text-slate-500 font-extrabold text-sm border-b-4 border-slate-400 btn-3d cursor-not-allowed">
                🔒 Terkunci
              </button>
            </div>
          </div>

          <!-- Level 3 Card -->
          <div id="card-level-3" class="rounded-2xl p-4 border-3 border-slate-300 bg-slate-100 flex flex-col justify-between transition relative overflow-hidden shadow">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span id="badge-level-3" class="bg-slate-500 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full">LEVEL 3 🔒</span>
                <div id="stars-level-3" class="text-base tracking-widest">☆☆☆</div>
              </div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-2xl">🖼️</span>
                <h3 class="text-base sm:text-lg font-extrabold text-slate-800">Amati & Tulis Kalimat</h3>
              </div>
              <p class="text-xs text-slate-600 mb-3">
                Amati gambar kegiatan dengan teliti, lalu tuliskan kalimat lengkapmu sendiri! (5 Soal)
              </p>
            </div>
            <div>
              <div class="text-[11px] font-bold text-slate-600 mb-1.5" id="score-label-3">Terkunci (Selesaikan Level 2)</div>
              <button id="btn-play-3" type="button" disabled class="w-full py-2 rounded-xl bg-slate-300 text-slate-500 font-extrabold text-sm border-b-4 border-slate-400 btn-3d cursor-not-allowed">
                🔒 Terkunci
              </button>
            </div>
          </div>
        </div>

        <!-- Button Guide Legend with Transparent Background -->
        <div class="mt-3 bg-sky-100/80 border-2 border-sky-200 rounded-2xl px-4 py-2 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <img src="data:image/png;base64," alt="Pensil Bingung" class="w-10 h-10 object-contain bg-transparent img-btn-transparent" />
            <div>
              <div class="font-bold text-xs text-sky-900">Kenali Tombol Navigasi & Suara</div>
              <div class="text-[11px] text-sky-700">Tiap soal bernilai 20 poin (Total 100 poin & maksimal 3 Bintang ⭐⭐⭐ tiap level).</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <img src="data:image/png;base64," alt="Tombol Kembali" class="h-8 w-auto object-contain bg-transparent img-btn-transparent" />
            <img src="data:image/png;base64," alt="Tombol Lanjut" class="h-8 w-auto object-contain bg-transparent img-btn-transparent" />
            <button id="btn-reset-all" type="button" class="text-xs bg-rose-500 hover:bg-rose-600 text-white font-bold px-3 py-1.5 rounded-xl transition shadow-sm">
              🔄 Reset Progres
            </button>
          </div>
        </div>
      </section>

      <!-- VIEW 2: GAMEPLAY VIEW (16:9 Optimized) -->
      <section id="view-game" class="game-card rounded-3xl p-4 sm:p-5 hidden flex-col justify-between h-full">
        <!-- Level Header & Progress Dots in 1 Compact Row -->
        <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b-2 border-sky-100">
          <div class="flex items-center gap-2.5">
            <span id="game-level-badge" class="bg-sky-500 text-white font-bold text-xs px-3 py-1 rounded-full">LEVEL 1</span>
            <h2 id="game-level-title" class="text-base sm:text-xl font-extrabold text-slate-800">Susun Kata Menjadi Kalimat</h2>
          </div>

          <!-- Progress Dots Inline -->
          <div id="game-progress-dots" class="flex items-center justify-center gap-1.5"></div>

          <div class="flex items-center gap-3">
            <div class="text-right">
              <div class="text-[10px] text-slate-500 font-bold">SOAL</div>
              <div id="game-question-counter" class="text-sm sm:text-base font-extrabold text-sky-700">1 / 5</div>
            </div>
            <div class="text-right bg-amber-50 border-2 border-amber-300 px-3 py-0.5 rounded-xl">
              <div class="text-[10px] text-amber-700 font-bold">SKOR LEVEL</div>
              <div id="game-current-score" class="text-sm sm:text-base font-extrabold text-amber-900">0</div>
            </div>
          </div>
        </div>

        <!-- Question Content Area (16:9 Horizontal Split) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-center my-auto py-2">
          <!-- Mascot & Voice Repeat Side (Light Transparent/Pastel Card, NO Black Box) -->
          <div class="lg:col-span-3 flex flex-col items-center justify-center bg-gradient-to-b from-sky-100/80 to-white p-3 rounded-2xl border-2 border-sky-200 shadow-sm">
            <img id="game-mascot-img" src="data:image/png;base64," alt="Si Pensil" class="w-24 h-24 sm:w-28 sm:h-28 object-contain bg-transparent mb-2 transition-all duration-300 img-btn-transparent" />
            <div id="game-mascot-speech" class="text-center text-xs font-semibold text-sky-950 bg-white/90 px-3 py-2 rounded-xl border border-sky-200 w-full shadow-inner">
              "Ayo baca soalnya baik-baik ya!"
            </div>
            <button id="btn-replay-voice" type="button" class="mt-2 text-[11px] font-bold text-pink-700 bg-pink-50 hover:bg-pink-100 border border-pink-300 px-2.5 py-1 rounded-full flex items-center gap-1 transition">
              <span>👩🏻‍🏫</span> <span>Putar Suara</span>
            </button>
          </div>

          <!-- Dynamic Interactive Area -->
          <div class="lg:col-span-9 flex flex-col justify-between bg-sky-50/70 p-3.5 sm:p-4 rounded-2xl border-2 border-sky-200">
            
            <!-- LEVEL 1 UI: DRAG & DROP SENTENCE -->
            <div id="ui-level-1" class="hidden flex-col gap-3">
              <div class="flex items-center justify-between">
                <p id="l1-instruction" class="text-xs sm:text-sm font-bold text-sky-900">
                  🧩 Tarik (drag) atau ketuk kata di bawah ke kotak jawaban agar menjadi kalimat yang utuh!
                </p>
                <span id="l1-emoji-hint" class="text-2xl">📚</span>
              </div>

              <!-- Drop Target Zone -->
              <div>
                <div class="text-[11px] font-bold text-sky-700 mb-1">KOTAK KALIMAT JAWABAN (Tarik kata ke sini):</div>
                <div id="l1-drop-zone" class="min-h-[64px] p-2.5 rounded-2xl bg-white border-3 border-dashed border-sky-400 flex flex-wrap items-center gap-2 transition">
                  <span id="l1-drop-placeholder" class="text-slate-400 text-xs sm:text-sm italic">Tarik atau ketuk kata-kata untuk menyusun kalimat di sini...</span>
                </div>
              </div>

              <!-- Source Word Bank -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[11px] font-bold text-slate-600">PILIHAN KATA ACAK:</span>
                  <button id="btn-l1-reset-words" type="button" class="text-xs text-sky-700 hover:underline font-bold">🔄 Ulangi Susunan</button>
                </div>
                <div id="l1-word-bank" class="min-h-[58px] p-2.5 rounded-2xl bg-amber-50 border-2 border-amber-300 flex flex-wrap items-center gap-2"></div>
              </div>
            </div>

            <!-- LEVEL 2 UI: FILL IN THE BLANK BY TYPING -->
            <div id="ui-level-2" class="hidden flex-col gap-3">
              <div class="flex items-center gap-3 bg-white p-2.5 rounded-2xl border-2 border-amber-200">
                <span id="l2-emoji" class="text-3xl">🌅</span>
                <div>
                  <div class="text-[10px] font-bold text-amber-600 uppercase">Petunjuk Kalimat</div>
                  <div id="l2-clue" class="text-xs sm:text-sm text-slate-700 font-medium">Lawan kata dari malam hari, saat matahari terbit.</div>
                </div>
              </div>

              <div class="bg-white p-3.5 rounded-2xl border-2 border-sky-300 text-center">
                <p class="text-[11px] font-bold text-sky-600 mb-1">LENGKAPI KALIMAT BERIKUT:</p>
                <div id="l2-sentence-display" class="text-base sm:text-xl font-extrabold text-slate-800 leading-relaxed">
                  Matahari terbit pada <span class="inline-block px-3 py-0.5 mx-1 rounded-xl bg-amber-100 border-2 border-amber-400 text-amber-800">...</span> hari.
                </div>
              </div>

              <div>
                <label for="l2-input" class="block text-xs font-bold text-slate-700 mb-1">KETIK JAWABANMU DI SINI (1 Kata):</label>
                <input id="l2-input" type="text" autocomplete="off" placeholder="Ketik kata yang tepat..." class="w-full px-4 py-2.5 rounded-xl border-2 border-sky-400 bg-white text-base font-bold text-slate-800 focus:outline-none focus:ring-4 focus:ring-sky-300" />
              </div>
            </div>

            <!-- LEVEL 3 UI: OBSERVE IMAGE & WRITE SENTENCE (NO EXAMPLE SENTENCE) -->
            <div id="ui-level-3" class="hidden flex-col gap-3">
              <div class="flex flex-col sm:flex-row items-center gap-3.5 bg-white p-3 rounded-2xl border-2 border-sky-200">
                <img id="l3-image" src="data:image/jpeg;base64," alt="Gambar Soal" class="w-36 h-36 sm:w-40 sm:h-40 object-cover rounded-2xl border-4 border-amber-300 shadow-sm flex-shrink-0" />
                <div class="flex-1 text-center sm:text-left">
                  <span class="inline-block bg-purple-100 text-purple-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full mb-1">AMATI GAMBAR</span>
                  <h3 id="l3-prompt-title" class="text-sm sm:text-base font-extrabold text-slate-800 mb-1">Apa yang sedang dilakukan tokoh pada gambar?</h3>
                  <p id="l3-hint-box" class="text-xs text-slate-600 mb-2">
                    Tulislah 1 kalimat lengkap (minimal 3 kata) menggunakan kata kunci bantuan di bawah ini!
                  </p>
                  <div class="bg-amber-50 border border-amber-300 rounded-xl p-2 text-xs text-amber-950">
                    💡 <strong>Kata Kunci Bantuan:</strong> <span id="l3-keywords" class="font-bold">Ibu, menyapu, lantai</span>
                  </div>
                </div>
              </div>

              <div>
                <label for="l3-textarea" class="block text-xs font-bold text-slate-700 mb-1">TULIS KALIMAT LENGKAPMU SENDIRI:</label>
                <textarea id="l3-textarea" rows="2" placeholder="Ketik kalimatmu di sini berdasarkan gambar dan kata kunci..." class="w-full px-3.5 py-2 rounded-xl border-2 border-sky-400 bg-white text-sm sm:text-base font-bold text-slate-800 focus:outline-none focus:ring-4 focus:ring-sky-300"></textarea>
              </div>
            </div>

            <!-- Feedback Banner Inside Gameplay -->
            <div id="game-feedback-box" class="hidden mt-2.5 p-2.5 rounded-xl border-2 text-xs sm:text-sm font-bold flex items-center justify-between gap-2">
              <div id="game-feedback-text"></div>
              <div id="game-feedback-points" class="px-2.5 py-1 rounded-lg bg-white/80 font-extrabold text-xs whitespace-nowrap"></div>
            </div>

          </div>
        </div>

        <!-- Bottom Action Bar with Transparent Image Buttons (NO Black Background) -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t-2 border-sky-100">
          <!-- Tombol Kembali Transparent (Image 53) -->
          <button id="btn-prev-question" type="button" class="img-btn-transparent focus:outline-none flex items-center p-0">
            <img src="data:image/png;base64," alt="Kembali" class="h-10 sm:h-12 w-auto object-contain bg-transparent" />
          </button>

          <!-- Check Answer Button -->
          <button id="btn-check-answer" type="button" class="px-6 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm sm:text-base border-b-4 border-amber-700 btn-3d shadow-md">
            ✅ Periksa Jawaban
          </button>

          <!-- Tombol Lanjut Transparent (Image 52) -->
          <button id="btn-next-question" type="button" class="img-btn-transparent focus:outline-none flex items-center p-0 opacity-40 cursor-not-allowed" disabled>
            <img src="data:image/png;base64," alt="Lanjut" class="h-10 sm:h-12 w-auto object-contain bg-transparent" />
          </button>
        </div>
      </section>

      <!-- VIEW 3: LEVEL RESULT & STAR MODAL -->
      <section id="view-result" class="game-card rounded-3xl p-5 sm:p-6 text-center hidden animate-pop flex-col justify-center h-full">
        <div class="max-w-lg mx-auto my-auto">
          <span id="result-level-badge" class="inline-block bg-sky-500 text-white font-bold text-xs px-4 py-1 rounded-full mb-2">HASIL LEVEL 1</span>
          <h2 id="result-title" class="text-2xl sm:text-3xl font-extrabold text-slate-800 mb-1">Luar Biasa!</h2>
          <p id="result-subtitle" class="text-slate-600 text-xs sm:text-sm mb-3">Kamu telah menyelesaikan semua 5 soal di level ini!</p>

          <!-- Mascot Reaction (Transparent Background) -->
          <div class="flex justify-center mb-2">
            <img id="result-mascot-img" src="data:image/png;base64," alt="Hasil Maskot" class="w-28 h-28 object-contain bg-transparent img-btn-transparent" />
          </div>

          <!-- Stars Earned Display -->
          <div id="result-stars-display" class="text-4xl sm:text-5xl mb-3 tracking-widest drop-shadow">
            ⭐⭐⭐
          </div>

