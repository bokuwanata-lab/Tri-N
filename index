    // Sound Synthesizer & Indonesian Female Voice Feedback (Web Speech API)
    let soundEnabled = true;
    let audioCtx = null;
    let cachedIndonesianVoice = null;
    let lastSpokenText = "Ayo baca soalnya baik-baik ya!";

    function selectIndonesianFemaleVoice() {
      if (!('speechSynthesis' in window)) return null;
      const voices = window.speechSynthesis.getVoices() || [];
      if (!voices.length) return null;

      // Filter Indonesian voices (id-ID / id_ID / indonesian)
      const idVoices = voices.filter(v =>
        /^id([-_]|$)/i.test(v.lang) ||
        v.lang.toLowerCase().includes('id-id') ||
        v.name.toLowerCase().includes('indonesia')
      );

      // Prefer known female Indonesian voice names (e.g., Gadis, Damayanti, Google Bahasa Indonesia, Female, Perempuan)
      const femaleKeywords = ['gadis', 'damayanti', 'female', 'wanita', 'perempuan', 'google bahasa indonesia', 'siti', 'putri'];
      for (const kw of femaleKeywords) {
        const found = idVoices.find(v => v.name.toLowerCase().includes(kw));
        if (found) return found;
      }
      if (idVoices.length > 0) return idVoices[0];
      return null;
    }

    if ('speechSynthesis' in window) {
      window.speechSynthesis.onvoiceschanged = () => {
        cachedIndonesianVoice = selectIndonesianFemaleVoice();
      };
      cachedIndonesianVoice = selectIndonesianFemaleVoice();
    }

    function speakIndonesianFemale(text) {
      lastSpokenText = text;
      if (!soundEnabled || !('speechSynthesis' in window)) return;
      try {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'id-ID';
        if (!cachedIndonesianVoice) {
          cachedIndonesianVoice = selectIndonesianFemaleVoice();
        }
        if (cachedIndonesianVoice) {
          utterance.voice = cachedIndonesianVoice;
        }
        // Slightly higher pitch and friendly rate for a warm female elementary teacher tone
        utterance.pitch = 1.18;
        utterance.rate = 0.98;
        utterance.volume = 1.0;
        window.speechSynthesis.speak(utterance);
      } catch (e) {
        // Fallback silently if speechSynthesis is restricted
      }
    }

    function playSound(type) {
      if (!soundEnabled) return;
      try {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContextClass();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const now = audioCtx.currentTime;

        if (type === 'click') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(680, now + 0.08);
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.08);
        } else if (type === 'correct') {
          const notes = [523.25, 659.25, 783.99, 1046.5];
          notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + idx * 0.08);
            gain.gain.setValueAtTime(0.14, now + idx * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.2);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now + idx * 0.08);
            osc.stop(now + idx * 0.08 + 0.2);
          });
        } else if (type === 'wrong') {
          const notes = [300, 240];
          notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(freq, now + idx * 0.12);
            gain.gain.setValueAtTime(0.1, now + idx * 0.12);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.18);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now + idx * 0.12);
            osc.stop(now + idx * 0.12 + 0.18);
          });
        } else if (type === 'win') {
          const notes = [523.25, 587.33, 659.25, 783.99, 1046.5];
          notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + idx * 0.09);
            gain.gain.setValueAtTime(0.16, now + idx * 0.09);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.09 + 0.25);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now + idx * 0.09);
            osc.stop(now + idx * 0.09 + 0.25);
          });
        }
      } catch (e) {}
    }

