        ui3.classList.remove('hidden');
        ui3.classList.add('flex');
        document.getElementById('l3-image').src = q.image;
        document.getElementById('l3-prompt-title').textContent = q.promptTitle;
        document.getElementById('l3-keywords').textContent = q.keywordsDisplay;

        const areaEl = document.getElementById('l3-textarea');
        areaEl.value = ansState.savedText || "";
        areaEl.disabled = ansState.answered && ansState.isCorrect;
      }

      if (!ansState.answered) {
        if (currentLevelId === 1) {
          setMascotState('think', `"${q.hint}"`);
          lastSpokenText = `Soal nomor ${currentQuestionIndex + 1}. Susunlah kata-kata berikut menjadi kalimat yang benar. ${q.hint}`;
        } else if (currentLevelId === 2) {
          setMascotState('think', `"Baca petunjuknya lalu ketik 1 kata yang tepat ya!"`);
          lastSpokenText = `Soal nomor ${currentQuestionIndex + 1}. ${q.before} titik-titik ${q.after} Petunjuk: ${q.clue}`;
        } else {
          setMascotState('think', `"Amati gambarnya, lalu tulis kalimatmu menggunakan kata kunci bantuan!"`);
          lastSpokenText = `Soal nomor ${currentQuestionIndex + 1}. Amati gambar berikut, lalu tulislah kalimatmu sendiri menggunakan kata kunci bantuan.`;
        }
      } else {
        showAnswerFeedback(ansState.isCorrect, ansState.feedbackMsg, ansState.points, false);
      }

      updateNavigationButtons();
    }

    // Level 1 Drag and Drop + Click Word Rendering
    function renderLevel1Words() {
      const dropZone = document.getElementById('l1-drop-zone');
      const wordBank = document.getElementById('l1-word-bank');
      const placeholder = document.getElementById('l1-drop-placeholder');
      const ansState = sessionAnswers[currentQuestionIndex];
      const locked = ansState.answered && ansState.isCorrect;

      Array.from(dropZone.querySelectorAll('.word-chip')).forEach(el => el.remove());
      wordBank.innerHTML = '';

      if (l1SelectedWords.length === 0) {
        placeholder.classList.remove('hidden');
      } else {
        placeholder.classList.add('hidden');
      }

      l1SelectedWords.forEach((item, index) => {
        const chip = createWordChip(item, 'drop', index, locked);
        dropZone.appendChild(chip);
      });

      l1BankWords.forEach((item, index) => {
        const chip = createWordChip(item, 'bank', index, locked);
        wordBank.appendChild(chip);
      });
    }

    function createWordChip(item, zone, index, locked) {
      const btn = document.createElement('div');
      btn.draggable = !locked;
      btn.dataset.wordId = item.id;
      btn.dataset.zone = zone;
      btn.dataset.index = index;

      const baseClass = "word-chip px-3.5 py-1.5 rounded-xl font-extrabold text-sm sm:text-base shadow-sm border-b-4 select-none flex items-center gap-1 ";
      if (zone === 'drop') {
        btn.className = baseClass + "bg-sky-500 text-white border-sky-700 hover:bg-sky-600";
      } else {
        btn.className = baseClass + "bg-white text-slate-800 border-amber-400 hover:bg-amber-100";
      }

      btn.textContent = item.text;

      if (!locked) {
        btn.addEventListener('click', () => {
          playSound('click');
          if (zone === 'bank') {
            const foundIdx = l1BankWords.findIndex(w => w.id === item.id);
            if (foundIdx > -1) {
              const [moved] = l1BankWords.splice(foundIdx, 1);
              l1SelectedWords.push(moved);
            }
          } else {
            const foundIdx = l1SelectedWords.findIndex(w => w.id === item.id);
            if (foundIdx > -1) {
              const [moved] = l1SelectedWords.splice(foundIdx, 1);
              l1BankWords.push(moved);
            }
          }
          renderLevel1Words();
        });

        btn.addEventListener('dragstart', (e) => {
          draggedWordItem = { id: item.id, from: zone };
          e.dataTransfer.setData('text/plain', item.id);
          setTimeout(() => btn.classList.add('opacity-40'), 0);
        });

        btn.addEventListener('dragend', () => {
          btn.classList.remove('opacity-40');
          draggedWordItem = null;
        });

        btn.addEventListener('dragover', (e) => {
          e.preventDefault();
        });

        btn.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!draggedWordItem) return;
          handleWordDrop(zone, index);
        });
      }

      return btn;
    }

    function handleWordDrop(targetZone, targetIndex = null) {
      if (!draggedWordItem) return;
      const { id, from } = draggedWordItem;
      let movedWord = null;

      if (from === 'bank') {
        const idx = l1BankWords.findIndex(w => w.id === id);
        if (idx > -1) [movedWord] = l1BankWords.splice(idx, 1);
      } else {
        const idx = l1SelectedWords.findIndex(w => w.id === id);
        if (idx > -1) [movedWord] = l1SelectedWords.splice(idx, 1);
      }

      if (!movedWord) return;
      playSound('click');

      if (targetZone === 'drop') {
        if (targetIndex !== null && targetIndex >= 0 && targetIndex <= l1SelectedWords.length) {
          l1SelectedWords.splice(targetIndex, 0, movedWord);
        } else {
          l1SelectedWords.push(movedWord);
        }
      } else {
        l1BankWords.push(movedWord);
      }

      draggedWordItem = null;
      renderLevel1Words();
    }

    function initDragAndDropZones() {
      const dropZone = document.getElementById('l1-drop-zone');
      const wordBank = document.getElementById('l1-word-bank');

      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('drop-zone-active');
      });
      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('drop-zone-active');
      });
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drop-zone-active');
        handleWordDrop('drop', null);
      });

      wordBank.addEventListener('dragover', (e) => {
        e.preventDefault();
      });
      wordBank.addEventListener('drop', (e) => {
        e.preventDefault();
        handleWordDrop('bank', null);
      });
    }

    // Show Feedback Banner, Mascot Reaction & Indonesian Female Voice Audio
    function showAnswerFeedback(isCorrect, message, points, shouldSpeak = true, voiceText = "") {
      const fbBox = document.getElementById('game-feedback-box');
      const fbText = document.getElementById('game-feedback-text');
      const fbPts = document.getElementById('game-feedback-points');

      fbBox.classList.remove('hidden');
      if (isCorrect) {
        fbBox.className = "mt-2.5 p-2.5 rounded-xl border-2 border-emerald-400 bg-emerald-100 text-emerald-950 text-xs sm:text-sm font-bold flex items-center justify-between gap-2 animate-pop";
        fbText.innerHTML = `🌟 <span>${message}</span>`;
        fbPts.textContent = `+${points} Poin`;
        fbPts.className = "px-2.5 py-1 rounded-lg bg-emerald-500 text-white font-extrabold text-xs whitespace-nowrap";
        setMascotState('happy', `"Prok prok prok! Hebat sekali, jawabanmu benar!"`);
      } else {
        fbBox.className = "mt-2.5 p-2.5 rounded-xl border-2 border-rose-400 bg-rose-100 text-rose-950 text-xs sm:text-sm font-bold flex items-center justify-between gap-2 animate-pop";
        fbText.innerHTML = `💡 <span>${message}</span>`;
        fbPts.textContent = `Coba Lagi`;
        fbPts.className = "px-2.5 py-1 rounded-lg bg-rose-500 text-white font-extrabold text-xs whitespace-nowrap";
        setMascotState('sad', `"Jangan menyerah ya! Ayo perbaiki jawabanmu!"`);
      }

      if (shouldSpeak) {
        speakIndonesianFemale(voiceText || message);
      }
    }

    // Validate Current Question Answer
    function checkCurrentAnswer() {
      const levelObj = LEVELS_DATA[currentLevelId];
      const q = levelObj.questions[currentQuestionIndex];
      const ansState = sessionAnswers[currentQuestionIndex];

      if (ansState.answered && ansState.isCorrect) {
        goNextQuestionOrFinish();
        return;
      }

      if (currentLevelId === 1) {
        if (l1SelectedWords.length < q.target.length) {
          playSound('wrong');
          showAnswerFeedback(
            false,
            "Masih ada kata yang belum dimasukkan ke kotak kalimat. Susun semua katanya ya!",
            0,
            true,
            "Masih ada kata yang belum dimasukkan ke kotak kalimat. Ayo susun semua katanya ya!"
          );
          return;
        }
        const userSentence = l1SelectedWords.map(w => w.text).join(' ');
        const targetSentence = q.target.join(' ');
        const isCorrect = userSentence.toLowerCase() === targetSentence.toLowerCase();

        ansState.answered = true;
        ansState.isCorrect = isCorrect;
        ansState.points = isCorrect ? 20 : 0;
        ansState.savedWords = {
          selected: [...l1SelectedWords],
          bank: [...l1BankWords]
        };

        let spokenFeedback = "";
        if (isCorrect) {
          playSound('correct');
          ansState.feedbackMsg = `Hebat! Susunan kalimatmu benar: "${targetSentence}."`;
          spokenFeedback = `Hebat sekali! Jawabanmu benar. ${targetSentence}. Kamu mendapat dua puluh poin!`;
        } else {
          playSound('wrong');
          ansState.feedbackMsg = `Urutan kalimat masih belum tepat. Petunjuk: ${q.hint}`;
          spokenFeedback = `Ups, urutan kalimatnya masih belum tepat. ${q.hint} Ayo coba lagi ya!`;
        }
        showAnswerFeedback(isCorrect, ansState.feedbackMsg, ansState.points, true, spokenFeedback);
        renderLevel1Words();

      } else if (currentLevelId === 2) {
        const inputEl = document.getElementById('l2-input');
        const rawVal = inputEl.value.trim().toLowerCase().replace(/[.,!?]/g, '');
        if (!rawVal) {
          playSound('wrong');
          showAnswerFeedback(
            false,
            "Ketik kata jawabanmu terlebih dahulu di kolom teks ya!",
            0,
            true,
            "Ketik kata jawabanmu terlebih dahulu di kolom jawaban ya!"
          );
          return;
        }

        const isCorrect = q.accepted.some(acc => rawVal === acc.toLowerCase());
        ansState.answered = true;
        ansState.isCorrect = isCorrect;
        ansState.points = isCorrect ? 20 : 0;
        ansState.savedText = inputEl.value.trim();

        let spokenFeedback = "";
        if (isCorrect) {
          playSound('correct');
          inputEl.disabled = true;
          ansState.feedbackMsg = `Tepat sekali! Kata "${ansState.savedText}" melengkapi kalimat dengan benar.`;
          spokenFeedback = `Pintar sekali! Kata ${ansState.savedText} adalah jawaban yang benar. ${q.before} ${ansState.savedText} ${q.after}`;
        } else {
          playSound('wrong');
          ansState.feedbackMsg = `Kurang tepat. Petunjuk: ${q.clue}`;
          spokenFeedback = `Jawabanmu masih kurang tepat. Ingat petunjuknya ya: ${q.clue} Ayo coba ketik lagi!`;
        }
        showAnswerFeedback(isCorrect, ansState.feedbackMsg, ansState.points, true, spokenFeedback);

      } else if (currentLevelId === 3) {
        const areaEl = document.getElementById('l3-textarea');
        const rawText = areaEl.value.trim();
        const cleanLower = rawText.toLowerCase();
        const words = cleanLower.split(/\s+/).filter(Boolean);

        if (words.length < 3) {
          playSound('wrong');
          showAnswerFeedback(
            false,
            "Tulislah kalimat lengkap minimal 3 kata berdasarkan kata kunci bantuan!",
            0,
            true,
            "Tulislah kalimat lengkap minimal tiga kata menggunakan kata kunci bantuan ya!"
          );
          return;
        }

        const hasSubject = q.subjectGroup.some(k => cleanLower.includes(k));
        const hasAction = q.actionGroup.some(k => cleanLower.includes(k));
        const hasObject = q.objectGroup.some(k => cleanLower.includes(k));

        const isCorrect = (hasAction && (hasSubject || hasObject)) || (hasSubject && hasObject);

        ansState.answered = true;
        ansState.isCorrect = isCorrect;
        ansState.points = isCorrect ? 20 : 0;
        ansState.savedText = rawText;

        let spokenFeedback = "";
        if (isCorrect) {
          playSound('correct');
          areaEl.disabled = true;
          ansState.feedbackMsg = `Luar biasa! Kalimat yang kamu tulis sudah tepat dan sesuai dengan gambar.`;
          spokenFeedback = `Wah, kalimat buatanmu bagus sekali dan sesuai dengan gambar! Kamu mendapat dua puluh poin!`;
        } else {
          playSound('wrong');
          ansState.feedbackMsg = `Kalimatmu belum memuat kegiatan pada gambar. Gunakan kata kunci bantuan: ${q.keywordsDisplay}.`;
          spokenFeedback = `Kalimatmu belum sesuai dengan gambar. Ayo gunakan kata kunci bantuan yang tersedia ya!`;
        }
        showAnswerFeedback(isCorrect, ansState.feedbackMsg, ansState.points, true, spokenFeedback);
      }

      document.getElementById('game-current-score').textContent = getSessionScore();
      renderProgressDots();
      updateNavigationButtons();
    }

    function updateNavigationButtons() {
      const prevBtn = document.getElementById('btn-prev-question');
      const nextBtn = document.getElementById('btn-next-question');
      const checkBtn = document.getElementById('btn-check-answer');
      const ansState = sessionAnswers[currentQuestionIndex];

      prevBtn.disabled = false;

      if (ansState.answered) {
        nextBtn.disabled = false;
        nextBtn.classList.remove('opacity-40', 'cursor-not-allowed');
      } else {
        nextBtn.disabled = true;
        nextBtn.classList.add('opacity-40', 'cursor-not-allowed');
      }

      if (ansState.answered && ansState.isCorrect) {
        if (currentQuestionIndex === 4) {
          checkBtn.textContent = "🏆 Lihat Hasil & Bintang";
          checkBtn.className = "px-6 py-2.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm sm:text-base border-b-4 border-emerald-700 btn-3d shadow-md";
        } else {
          checkBtn.textContent = "➡ Soal Berikutnya";
          checkBtn.className = "px-6 py-2.5 rounded-2xl bg-sky-500 hover:bg-sky-600 text-white font-extrabold text-sm sm:text-base border-b-4 border-sky-700 btn-3d shadow-md";
        }
      } else {
        checkBtn.textContent = "✅ Periksa Jawaban";
        checkBtn.className = "px-6 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm sm:text-base border-b-4 border-amber-700 btn-3d shadow-md";
      }
    }

    function goNextQuestionOrFinish() {
      playSound('click');
      if (currentQuestionIndex < 4) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        finishLevel();
      }
    }

    function finishLevel() {
      playSound('win');
      const finalScore = getSessionScore();
      const correctCount = sessionAnswers.filter(a => a.isCorrect).length;
      const earnedStars = calcStars(finalScore);

      progress.levelCompleted[currentLevelId] = true;
      if (finalScore > (progress.levelScores[currentLevelId] || 0)) {
        progress.levelScores[currentLevelId] = finalScore;
      }
      if (earnedStars > (progress.levelStars[currentLevelId] || 0)) {
        progress.levelStars[currentLevelId] = earnedStars;
      }

      if (currentLevelId === 1 && progress.unlockedLevel < 2) {
        progress.unlockedLevel = 2;
      } else if (currentLevelId === 2 && progress.unlockedLevel < 3) {
        progress.unlockedLevel = 3;
      }

      saveProgress();
      renderMapAndHeader();

      document.getElementById('result-level-badge').textContent = `HASIL LEVEL ${currentLevelId}`;
      document.getElementById('result-stars-display').textContent = formatStars(earnedStars);
      document.getElementById('result-score-value').textContent = `${finalScore} / 100`;
      document.getElementById('result-correct-count').textContent = `${correctCount} / 5 Soal`;

      const resMascot = document.getElementById('result-mascot-img');
      const resTitle = document.getElementById('result-title');
      const resSub = document.getElementById('result-subtitle');
      const unlockBanner = document.getElementById('result-unlock-banner');
      const nextLvlBtn = document.getElementById('btn-result-next-level');

      if (earnedStars === 3) {
        resMascot.src = MASCOT_HAPPY;
        resTitle.textContent = "Hebat Sekali! Bintang Sempurna!";
        resSub.textContent = "Kamu berhasil menjawab soal-soal di level ini dengan sangat cemerlang!";
      } else if (earnedStars === 2) {
        resMascot.src = MASCOT_HAPPY;
        resTitle.textContent = "Kerja Bagus! Kamu Dapat 2 Bintang!";
        resSub.textContent = "Sedikit lagi menuju bintang penuh, terus semangat belajar ya!";
      } else if (earnedStars === 1) {
        resMascot.src = MASCOT_THINK;
        resTitle.textContent = "Tetap Semangat! Kamu Dapat 1 Bintang!";
        resSub.textContent = "Kamu sudah menyelesaikan level ini. Yuk coba lagi agar bintangmu bertambah!";
      } else {
        resMascot.src = MASCOT_SAD;
        resTitle.textContent = "Jangan Menyerah Ya!";
        resSub.textContent = "Ayo coba mainkan ulang level ini dan perhatikan petunjuk Si Pensil!";
      }

      let unlockVoice = "";
      if (currentLevelId === 1) {
        unlockBanner.textContent = "🔓 Hore! Level 2 (Melengkapi Kalimat) sekarang sudah TERBUKA!";
        nextLvlBtn.classList.remove('hidden');
        nextLvlBtn.textContent = "🚀 Lanjut ke Level 2";
        unlockVoice = "Level dua sekarang sudah terbuka!";
      } else if (currentLevelId === 2) {
        unlockBanner.textContent = "🔓 Hore! Level 3 (Amati Gambar & Tulis Kalimat) sekarang sudah TERBUKA!";
        nextLvlBtn.classList.remove('hidden');
        nextLvlBtn.textContent = "🚀 Lanjut ke Level 3";
        unlockVoice = "Level tiga sekarang sudah terbuka!";
      } else {
        unlockBanner.textContent = "🏆 Selamat! Kamu telah menamatkan seluruh 3 Level Petualangan Kalimat SD!";
        nextLvlBtn.classList.add('hidden');
        unlockVoice = "Selamat, kamu telah menamatkan seluruh tiga level permainan!";
      }

      showView('view-result');
      speakIndonesianFemale(`Selamat! Kamu menyelesaikan level ${currentLevelId} dengan skor ${finalScore} dan mendapat ${earnedStars} bintang. ${unlockVoice}`);
    }

    // Event Listeners Registration
    window.addEventListener('DOMContentLoaded', () => {
      loadProgress();
      renderMapAndHeader();
      initDragAndDropZones();

      document.getElementById('btn-play-1').addEventListener('click', () => startLevel(1));
      document.getElementById('btn-play-2').addEventListener('click', () => {
        if (progress.unlockedLevel >= 2 || progress.levelCompleted[1]) startLevel(2);
      });
      document.getElementById('btn-play-3').addEventListener('click', () => {
        if (progress.unlockedLevel >= 3 || progress.levelCompleted[2]) startLevel(3);
      });

      document.getElementById('btn-home-map').addEventListener('click', () => {
        playSound('click');
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        renderMapAndHeader();
        showView('view-map');
      });

      document.getElementById('btn-sound-toggle').addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        document.getElementById('btn-sound-toggle').textContent = soundEnabled ? '🔊' : '🔇';
        if (!soundEnabled && ('speechSynthesis' in window)) {
          window.speechSynthesis.cancel();
        } else if (soundEnabled) {
          playSound('click');
          speakIndonesianFemale("Suara pemandu diaktifkan.");
        }
      });

      document.getElementById('btn-replay-voice').addEventListener('click', () => {
        playSound('click');
        speakIndonesianFemale(lastSpokenText);
      });

      document.getElementById('btn-reset-all').addEventListener('click', () => {
        playSound('click');
        progress = JSON.parse(JSON.stringify(defaultProgress));
        saveProgress();
        renderMapAndHeader();
      });

      document.getElementById('btn-l1-reset-words').addEventListener('click', () => {
        const ansState = sessionAnswers[currentQuestionIndex];
        if (ansState.answered && ansState.isCorrect) return;
        playSound('click');
        const q = LEVELS_DATA[1].questions[currentQuestionIndex];
        l1SelectedWords = [];
        l1BankWords = q.scrambled.map((w, i) => ({ id: `w_${currentQuestionIndex}_${i}`, text: w }));
        ansState.answered = false;
        document.getElementById('game-feedback-box').classList.add('hidden');
        renderLevel1Words();
        updateNavigationButtons();
      });

      const l2Input = document.getElementById('l2-input');
      l2Input.addEventListener('input', () => {
        const preview = document.getElementById('l2-blank-preview');
        if (preview) {
          preview.textContent = l2Input.value.trim() || "...";
        }
      });
      l2Input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          checkCurrentAnswer();
        }
      });

      document.getElementById('btn-check-answer').addEventListener('click', () => {
        checkCurrentAnswer();
      });

      document.getElementById('btn-prev-question').addEventListener('click', () => {
        playSound('click');
        if (currentQuestionIndex > 0) {
          currentQuestionIndex--;
          renderQuestion();
        } else {
          renderMapAndHeader();
          showView('view-map');
        }
      });

      document.getElementById('btn-next-question').addEventListener('click', () => {
        const ansState = sessionAnswers[currentQuestionIndex];
        if (!ansState.answered) return;
        goNextQuestionOrFinish();
      });

      document.getElementById('btn-result-retry').addEventListener('click', () => {
        startLevel(currentLevelId);
      });

      document.getElementById('btn-result-map').addEventListener('click', () => {
        playSound('click');
        renderMapAndHeader();
        showView('view-map');
      });

      document.getElementById('btn-result-next-level').addEventListener('click', () => {
        if (currentLevelId < 3) {
          startLevel(currentLevelId + 1);
        }
      });
    });
  </script>
